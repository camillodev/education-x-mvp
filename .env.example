# Education X — variáveis de ambiente (copie para .env.local e preencha)
# NUNCA commitar .env.local. Secrets via env, nunca hardcoded.

# Database (Supabase PostgreSQL, sa-east-1)
DATABASE_URL=
DIRECT_URL=

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Asaas (sandbox primeiro)
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_MASTER_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Criptografia de API keys de subconta (AES-256-GCM)
ENCRYPTION_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
