// Education X — Prisma schema
// Multi-tenant: every query must be filtered by unitId (from Clerk session, never HTTP param)
// Values in cents (Int) throughout the app; convert to reais only at Asaas client boundary

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UnitStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum FeePayer {
  RESPONSAVEL
  ESCOLA
}

enum DiscountType {
  PERCENT
  FIXED
}

enum TermsKind {
  IX_ESCOLA
  ESCOLA_RESPONSAVEL
  PRIVACY
}

enum GuardianType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
}

enum EnrollmentPlan {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum EnrollmentStatus {
  PENDING_CONFIRMATION
  PENDING_SCHOOL_APPROVAL
  ACTIVE
  CANCELLED
  SUSPENDED
}

enum InvoiceStatus {
  PENDING // cobrança gerada, aguardando pagamento
  PAID // PAYMENT_RECEIVED recebido e processado
  OVERDUE // vencida (PAYMENT_OVERDUE do webhook)
  CANCELLED // cancelada manualmente ou pela escola
  BLOCKED // não pode ser gerada (Guardian sem asaasCustomerId)
  ERROR // falha na criação no Asaas
}

enum FirstChargeMode {
  PROPORTIONAL // cobra proporcional aos dias restantes do ciclo (padrão)
  FREE_FIRST_MONTH // não emite Invoice na 1ª competência; cobra cheia a partir do 2º mês
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Unit {
  id              String     @id @default(cuid())
  name            String
  cnpj            String     @unique
  // Dados públicos da Receita (BrasilAPI) — guardados para contratos futuros.
  legalName       String? // razão social
  tradeName       String? // nome fantasia
  cnpjStatus      String? // situação cadastral (ATIVA, BAIXADA, etc.)
  email           String
  phone           String
  cep             String
  address         String
  number          String
  neighborhood    String
  complement      String?
  city            String
  state           String
  isFranchise     Boolean    @default(false)
  franchiseParent String?
  status          UnitStatus @default(PENDING)

  // Responsável da unidade (quem recebe o aceite dos termos por e-mail)
  responsibleName  String
  responsibleEmail String
  responsiblePhone String

  // Aceite dos termos via link de confirmação (sem login)
  confirmationToken          String?   @unique
  confirmationTokenExpiresAt DateTime?
  confirmedAt                DateTime?

  // Link público e estável de matrícula (/m/[token]) — não expira, rotacionável
  enrollmentLinkToken String? @unique

  // Asaas subconta
  asaasAccountId String?
  asaasApiKeyEnc String? // AES-256-GCM: iv:authTag:ciphertext
  asaasWalletId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingConfig    BillingConfig?
  subjects         Subject[]
  guardians        Guardian[]
  students         Student[]
  enrollments      Enrollment[]
  termsAcceptances TermsAcceptance[]
  invoices         Invoice[]
  payments         Payment[]

  @@map("units")
}

model BillingConfig {
  id     String @id @default(cuid())
  unitId String @unique

  dueDay            Int // 1..28
  closingDay        Int // 1..28
  lateFeePercent    Int // basis points (200 = 2%)
  monthlyInterestBp Int // basis points (100 = 1% a.m.)

  enablesSpc          Boolean  @default(false)
  autoBilling         Boolean  @default(true)
  acceptsCard         Boolean  @default(false)
  cardFeePayer        FeePayer @default(RESPONSAVEL)
  negativacaoFeePayer FeePayer @default(RESPONSAVEL)

  municipalRegistration String
  requireSignedContract Boolean @default(false)
  contractFileName      String?

  // Plano da escola (escola → Impact X). Preço em snapshot pra não quebrar se a constante mudar.
  planId             String        @default("basico")
  planPriceCents     Int           @default(39900)
  isBeta             Boolean       @default(false)
  discountType       DiscountType?
  discountValueBp    Int? // se PERCENT (200 = 2%)
  discountValueCents Int? // se FIXED

  firstChargeMode FirstChargeMode @default(PROPORTIONAL)

  asaasWebhookTokenEnc String? // AES-256-GCM

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("billing_configs")
}

model Subject {
  id                   String  @id @default(cuid())
  unitId               String
  name                 String
  nfseServiceCode      String
  priceCents           Int // always in cents
  quarterlyPriceCents  Int? // optional quarterly price
  semiannualPriceCents Int? // optional semiannual price
  annualPriceCents     Int? // optional annual price
  isActive             Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([unitId])
  @@map("subjects")
}

// ─── People ───────────────────────────────────────────────────────────────────

model Guardian {
  id        String        @id @default(cuid())
  unitId    String
  name      String
  type      GuardianType?
  selfPayer Boolean       @default(true)

  // PII encrypted with AES-256-GCM — never plaintext in DB
  cpfEnc   String?
  emailEnc String?
  phoneEnc String?

  asaasCustomerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  students         Student[]
  enrollments      Enrollment[]
  termsAcceptances TermsAcceptance[]

  @@index([unitId])
  @@map("guardians")
}

model Student {
  id           String  @id @default(cuid())
  unitId       String
  guardianId   String
  // PII encrypted with AES-256-GCM — never plaintext in DB
  nameEnc      String
  birthDateEnc String
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guardian    Guardian     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([unitId])
  @@index([guardianId])
  @@map("students")
}

model Enrollment {
  id         String @id @default(cuid())
  unitId     String
  guardianId String
  studentId  String
  subjectId  String

  plan               EnrollmentPlan
  agreedPriceCents   Int
  discountType       DiscountType?
  discountValueBp    Int?
  discountValueCents Int?
  finalPriceCents    Int
  status             EnrollmentStatus @default(PENDING_CONFIRMATION)
  confirmationToken  String?          @unique

  // Campos antecipados para F2/F3 (cobrança/dunning) — mesma tabela, spec SCHEMA-CONSOLIDADO.md
  customDueDay      Int?
  isFirstChargeDone Boolean   @default(false)
  dunningPaused     Boolean   @default(false)
  startedAt         DateTime?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guardian Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject  Subject   @relation(fields: [subjectId], references: [id])
  invoices Invoice[]

  @@index([unitId, status])
  @@index([unitId, cancelledAt])
  @@index([unitId, subjectId, status])
  @@map("enrollments")
}

// ─── Terms ────────────────────────────────────────────────────────────────────

model TermsVersion {
  id      String    @id @default(cuid())
  unitId  String? // null = versão global da plataforma (IX_ESCOLA, PRIVACY); preenchido = contrato próprio da escola (ESCOLA_RESPONSAVEL)
  kind    TermsKind
  version String // e.g. "1.0"
  body    String    @db.Text

  createdAt DateTime @default(now())

  acceptances TermsAcceptance[]

  @@index([unitId, kind, createdAt])
  @@map("terms_versions")
}

model TermsAcceptance {
  id             String   @id @default(cuid())
  unitId         String
  guardianId     String? // null = aceite da escola no onboarding (confirmSchool); preenchido = aceite do responsável na matrícula
  termsVersionId String
  ip             String
  acceptedAt     DateTime @default(now())

  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  guardian     Guardian?    @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id])

  @@index([unitId])
  @@index([guardianId])
  @@map("terms_acceptances")
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Invoice {
  id           String @id @default(cuid())
  unitId       String
  enrollmentId String

  // Valores em centavos. amountCents = Enrollment.finalPriceCents no momento da emissão
  // (snapshot com desconto já aplicado); na 1ª competência com firstChargeMode = PROPORTIONAL,
  // é o valor proporcional calculado (RN-14).
  amountCents    Int
  netAmountCents Int // mantido por compatibilidade com o fluxo de pagamento; = amountCents nesta camada

  referenceMonth String // "2026-06" — mês de competência
  dueDate        DateTime

  status InvoiceStatus @default(PENDING)

  // Vínculo Asaas (preenchido após POST /payments)
  asaasPaymentId   String?
  asaasPaymentUrl  String?
  asaasBankSlipUrl String?
  asaasBarCode     String?

  emittedAt       DateTime?
  paidAt          DateTime?
  paidAmountCents Int?

  // Idempotência: cron/manual/lote não duplicam (enrollmentId + ":" + referenceMonth)
  idempotencyKey String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  payments   Payment[]

  @@index([unitId])
  @@index([enrollmentId])
  @@index([asaasPaymentId])
  @@index([referenceMonth])
  // EDU-27 — listInvoices filtra por unitId (via forUnit) + status e por unitId +
  // referenceMonth; composto na ordem do filtro (regra database.md), sem isso a query cai
  // no índice simples de unitId e faz scan do resto sob o filtro.
  @@index([unitId, status])
  @@index([unitId, referenceMonth])
  @@map("invoices")
}

model Payment {
  id        String @id @default(cuid())
  unitId    String
  invoiceId String

  // Dados do evento webhook Asaas
  asaasPaymentId String
  asaasEvent     String // PAYMENT_RECEIVED | PAYMENT_OVERDUE etc
  asaasStatus    String // status retornado pelo Asaas
  amountCents    Int
  paidAt         DateTime
  clientPaidAt   DateTime?

  // Idempotência: não processar o mesmo evento webhook duas vezes
  webhookEventId String @unique

  createdAt DateTime @default(now())

  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([unitId])
  @@index([invoiceId])
  @@index([asaasPaymentId])
  @@map("payments")
}
