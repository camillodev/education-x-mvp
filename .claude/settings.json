{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*)"
    ],
    "allow": [
      "Bash(~/scripts/list-env-keys.sh:*)",
      "Bash(bash ~/scripts/list-env-keys.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/playwright-required.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_playwright_playwright__browser_resize|mcp__plugin_playwright_playwright__browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/mark-playwright-ran.sh"
          }
        ]
      }
    ]
  }
}
