/* Education X — shared atoms (Alfabeto theme).
 * Exposed on window for cross-file use. */

const { useState, useEffect, useRef, useMemo } = React;

/* ── Icon (lucide CDN) ─────────────────────────────────────────────────── */
const Icon = ({ name, size = 18, color, strokeWidth = 2, style = {} }) => {
  const ref = useRef(null);
  useEffect(() => {
    if (window.lucide && ref.current) {
      ref.current.innerHTML = "";
      const el = document.createElement("i");
      el.setAttribute("data-lucide", name);
      ref.current.appendChild(el);
      window.lucide.createIcons({ attrs: { width: size, height: size, "stroke-width": strokeWidth } });
    }
  }, [name, size, strokeWidth]);
  return <span ref={ref} style={{ display: "inline-flex", color: color ?? "currentColor", width: size, height: size, flexShrink: 0, ...style }} aria-hidden="true" />;
};

/* ── money / format ────────────────────────────────────────────────────── */
const brl = (n) => "R$ " + n.toLocaleString("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

/* ── Button ────────────────────────────────────────────────────────────── */
const Button = ({ variant = "primary", size = "md", iconLeft, iconRight, children, onClick, type = "button", disabled, block, style = {}, ...rest }) => {
  const [hover, setHover] = useState(false);
  const sizes = { sm: { h: 34, px: 14, fs: 13 }, md: { h: 42, px: 18, fs: 14.5 }, lg: { h: 50, px: 22, fs: 16 } };
  const s = sizes[size];
  const palette = {
    primary: { bg: hover ? "var(--color-primary-hover)" : "var(--color-primary)", fg: "var(--color-primary-fg)", bd: "transparent", sh: "var(--shadow-sm)" },
    secondary: { bg: hover ? "var(--color-secondary-hover)" : "var(--color-secondary)", fg: "var(--color-secondary-bd)", bd: "1.5px solid var(--color-secondary-bd)", sh: "none" },
    tertiary: { bg: hover ? "var(--color-tertiary-hover)" : "transparent", fg: "var(--color-text-muted)", bd: "transparent", sh: "none" },
    danger: { bg: hover ? "var(--color-danger-primary-hover)" : "var(--color-danger-primary)", fg: "var(--color-danger-primary-fg)", bd: "transparent", sh: "var(--shadow-sm)" },
    "danger-outline": { bg: hover ? "var(--color-danger-soft)" : "var(--color-bg)", fg: "var(--color-danger-secondary-fg)", bd: "1.5px solid var(--color-danger-secondary-bd)", sh: "none" }
  };
  const v = palette[variant];
  return (
    <button type={type} onClick={onClick} disabled={disabled}
    onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)} {...rest}
    style={{
      display: block ? "flex" : "inline-flex", width: block ? "100%" : "auto",
      alignItems: "center", justifyContent: "center", gap: 9,
      height: s.h, padding: `0 ${s.px}px`, borderRadius: "var(--radius-md)",
      fontFamily: "var(--font-sans)", fontSize: s.fs, fontWeight: 600, letterSpacing: "-0.01em",
      cursor: disabled ? "not-allowed" : "pointer", background: v.bg, color: v.fg, border: v.bd,
      boxShadow: v.sh, opacity: disabled ? 0.45 : 1, whiteSpace: "nowrap",
      transition: "background 140ms, color 140ms, border-color 140ms, box-shadow 140ms",
      ...style
    }}>
      {iconLeft && <Icon name={iconLeft} size={size === "lg" ? 19 : 16} />}
      {children}
      {iconRight && <Icon name={iconRight} size={size === "lg" ? 19 : 16} />}
    </button>);

};

/* ── Card ──────────────────────────────────────────────────────────────── */
const Card = ({ children, interactive, active, onClick, pad = 0, style = {}, ...rest }) => {
  const [hover, setHover] = useState(false);
  return (
    <div onClick={onClick} {...rest}
    onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}
    style={{
      background: "var(--color-bg)", borderRadius: "var(--radius-lg)",
      border: `${active ? 2 : 1}px solid ${active ? "var(--color-primary)" : "var(--color-border)"}`,
      boxShadow: interactive && hover ? "var(--shadow-card-hover)" : "var(--shadow-card)",
      transition: "border-color 140ms, box-shadow 140ms, transform 140ms",
      cursor: interactive ? "pointer" : "default",
      transform: interactive && hover ? "translateY(-2px)" : "none",
      padding: pad, ...style
    }}>
      {children}
    </div>);

};

/* ── Badge ─────────────────────────────────────────────────────────────── */
const Badge = ({ variant = "neutral", children, dot, size = "md", style = {} }) => {
  const map = {
    success: ["var(--badge-success-bg)", "var(--badge-success-fg)"],
    warning: ["var(--badge-warning-bg)", "var(--badge-warning-fg)"],
    danger: ["var(--badge-danger-bg)", "var(--badge-danger-fg)"],
    info: ["var(--badge-info-bg)", "var(--badge-info-fg)"],
    primary: ["var(--color-primary-soft)", "var(--color-primary-hover)"],
    neutral: ["var(--badge-neutral-bg)", "var(--badge-neutral-fg)"]
  };
  const [bg, fg] = map[variant];
  const s = size === "sm" ? { py: 3, px: 9, fs: 11.5 } : { py: 5, px: 11, fs: 12.5 };
  return (
    <span style={{
      display: "inline-flex", alignItems: "center", gap: 6, padding: `${s.py}px ${s.px}px`,
      borderRadius: "var(--radius-full)", background: bg, color: fg,
      fontSize: s.fs, fontWeight: 600, lineHeight: 1, whiteSpace: "nowrap", ...style
    }}>
      {dot && <span style={{ width: 6, height: 6, borderRadius: "50%", background: fg }} />}
      {children}
    </span>);

};

// map cobrança status -> badge variant + label
const STATUS = {
  paga: { variant: "success", label: "Paga" },
  pago: { variant: "success", label: "Pago" },
  avencer: { variant: "warning", label: "A vencer" },
  vencida: { variant: "danger", label: "Vencida" },
  pendente: { variant: "info", label: "Pendente" },
  contestacao: { variant: "warning", label: "Em contestação" },
  emaviso: { variant: "warning", label: "Em aviso" },
  elegivel: { variant: "danger", label: "Elegível p/ negativar" },
  negativado: { variant: "danger", label: "Negativado" },
  regularizado: { variant: "success", label: "Regularizado" }
};
const StatusBadge = ({ status, size }) => {
  const s = STATUS[status] || { variant: "neutral", label: status };
  return <Badge variant={s.variant} dot size={size}>{s.label}</Badge>;
};

/* ── Input ─────────────────────────────────────────────────────────────── */
const Field = ({ label, error, hint, required, children }) =>
<div style={{ display: "flex", flexDirection: "column", gap: 7 }}>
    {label &&
  <label style={{ fontSize: 13, fontWeight: 600, color: "var(--color-text-muted-strong)" }}>
        {label}{required && <span style={{ color: "var(--color-danger-primary)", marginLeft: 3 }}>*</span>}
      </label>
  }
    {children}
    {error ?
  <span style={{ fontSize: 12.5, color: "var(--color-danger-primary)", display: "inline-flex", alignItems: "center", gap: 5 }}><Icon name="alert-circle" size={13} />{error}</span> :
  hint ? <span style={{ fontSize: 12.5, color: "var(--color-text-subtle)" }}>{hint}</span> : null}
  </div>;


const Input = ({ value, onChange, placeholder, type = "text", inputMode, leadingIcon, trailing, error, disabled, style = {}, ...rest }) => {
  const [focused, setFocused] = useState(false);
  return (
    <div style={{
      display: "flex", alignItems: "center", gap: 10, height: 46, padding: "0 14px",
      borderRadius: "var(--radius-md)", background: disabled ? "var(--color-surface)" : "var(--color-bg)",
      border: `1.5px solid ${error ? "var(--color-danger-primary)" : focused ? "var(--color-primary)" : "var(--color-border-input)"}`,
      boxShadow: focused && !error ? "0 0 0 3px var(--color-primary-ring)" : "none",
      transition: "border-color 140ms, box-shadow 140ms", ...style
    }}>
      {leadingIcon && <Icon name={leadingIcon} size={17} color="var(--color-text-subtle)" />}
      <input value={value} onChange={onChange} placeholder={placeholder} type={type} inputMode={inputMode} disabled={disabled}
      onFocus={() => setFocused(true)} onBlur={() => setFocused(false)} {...rest}
      style={{ flex: 1, border: "none", outline: "none", background: "transparent",
        fontFamily: "var(--font-sans)", fontSize: 15, color: "var(--color-text)", minWidth: 0 }} />
      {trailing}
    </div>);

};

const Toggle = ({ checked, onChange, disabled }) =>
<button type="button" role="switch" aria-checked={checked} disabled={disabled}
onClick={() => !disabled && onChange(!checked)}
style={{
  width: 46, height: 27, borderRadius: 999, border: "none", padding: 3, flexShrink: 0,
  background: checked ? "var(--color-primary)" : "var(--color-border-strong)",
  cursor: disabled ? "not-allowed" : "pointer", transition: "background 160ms", opacity: disabled ? 0.5 : 1
}}>
    <span style={{ display: "block", width: 21, height: 21, borderRadius: "50%", background: "#fff",
    boxShadow: "var(--shadow-sm)", transform: checked ? "translateX(19px)" : "none", transition: "transform 160ms" }} />
  </button>;


const Checkbox = ({ checked, onChange, children, style = {} }) =>
<label style={{ display: "flex", gap: 12, alignItems: "flex-start", cursor: "pointer", ...style }}>
    <span style={{
    width: 22, height: 22, borderRadius: 6, flexShrink: 0, marginTop: 1,
    border: `1.5px solid ${checked ? "var(--color-primary)" : "var(--color-border-input)"}`,
    background: checked ? "var(--color-primary)" : "var(--color-bg)",
    display: "flex", alignItems: "center", justifyContent: "center", transition: "all 140ms"
  }} onClick={() => onChange(!checked)}>
      {checked && <Icon name="check" size={15} color="#fff" strokeWidth={3} />}
    </span>
    <span style={{ fontSize: 14, color: "var(--color-text-muted)", lineHeight: 1.5 }}>{children}</span>
  </label>;


/* ── Segmented control ─────────────────────────────────────────────────── */
const Segmented = ({ options, value, onChange, size = "md", style = {} }) => {
  const h = size === "sm" ? 34 : 40;
  return (
    <div style={{ display: "inline-flex", background: "var(--color-surface)", padding: 4, borderRadius: "var(--radius-md)",
      border: "1px solid var(--color-border)", gap: 2, ...style }}>
      {options.map((o) => {
        const v = typeof o === "string" ? o : o.value;
        const lbl = typeof o === "string" ? o : o.label;
        const active = v === value;
        return (
          <button key={v} type="button" onClick={() => onChange(v)}
          style={{ height: h - 8, padding: "0 16px", borderRadius: 7, border: "none", cursor: "pointer",
            fontFamily: "var(--font-sans)", fontSize: 13.5, fontWeight: 600, whiteSpace: "nowrap",
            background: active ? "var(--color-bg)" : "transparent",
            color: active ? "var(--color-primary)" : "var(--color-text-muted)",
            boxShadow: active ? "var(--shadow-sm)" : "none", transition: "all 140ms",
            display: "inline-flex", alignItems: "center", gap: 7 }}>
            {typeof o === "object" && o.count != null &&
            <span style={{ fontSize: 11, fontWeight: 700, padding: "1px 7px", borderRadius: 999,
              background: active ? "var(--color-primary-soft)" : "var(--color-border)",
              color: active ? "var(--color-primary-hover)" : "var(--color-text-muted)" }}>{o.count}</span>
            }
            {lbl}
          </button>);

      })}
    </div>);

};

/* ── Chip (multi-select pill) ──────────────────────────────────────────── */
const Chip = ({ label, active, onClick, icon, color }) =>
<button type="button" onClick={onClick}
style={{ display: "inline-flex", alignItems: "center", gap: 7, height: 40, padding: "0 16px",
  borderRadius: "var(--radius-full)", fontFamily: "var(--font-sans)", fontSize: 14.5, fontWeight: 600,
  background: active ? "var(--color-primary)" : "var(--color-bg)",
  color: active ? "var(--color-primary-fg)" : "var(--color-text-muted)",
  border: `1.5px solid ${active ? "var(--color-primary)" : "var(--color-border-input)"}`,
  cursor: "pointer", transition: "all 140ms" }}>
    {color && <span style={{ width: 9, height: 9, borderRadius: "50%", background: color }} />}
    {icon && <Icon name={icon} size={16} />}
    {label}
  </button>;


/* ── Stepper (wizard progress) ─────────────────────────────────────────── */
const Stepper = ({ steps, current, compact }) =>
<div style={{ display: "flex", alignItems: "center", gap: compact ? 6 : 0, width: "100%" }}>
    {steps.map((label, i) => {
    const done = i < current,active = i === current;
    return (
      <React.Fragment key={i}>
          <div style={{ display: "flex", alignItems: "center", gap: 10, flexShrink: 0 }}>
            <div style={{ width: 30, height: 30, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center",
            fontSize: 13.5, fontWeight: 700, transition: "all 160ms",
            background: done ? "var(--color-primary)" : active ? "var(--color-primary)" : "var(--color-bg)",
            color: done || active ? "#fff" : "var(--color-text-subtle)",
            border: `1.5px solid ${done || active ? "var(--color-primary)" : "var(--color-border-input)"}` }}>
              {done ? <Icon name="check" size={15} strokeWidth={3} /> : i + 1}
            </div>
            {!compact && <span style={{ fontSize: 13.5, fontWeight: active ? 600 : 500,
            color: active ? "var(--color-text)" : done ? "var(--color-text-muted)" : "var(--color-text-subtle)" }}>{label}</span>}
          </div>
          {i < steps.length - 1 && <div style={{ flex: 1, height: 2, margin: "0 12px", borderRadius: 2, minWidth: 16,
          background: done ? "var(--color-primary)" : "var(--color-border)" }} />}
        </React.Fragment>);

  })}
  </div>;


/* ── Metric card ───────────────────────────────────────────────────────── */
const Metric = ({ label, value, sub, icon, accent = "var(--color-text)", iconBg = "var(--color-surface)", trend }) =>
<Card style={{ padding: 20, display: "flex", flexDirection: "column", gap: 14 }}>
    <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
      <span className="label" style={{ fontSize: 11.5 }}>{label}</span>
      <span style={{ width: 36, height: 36, borderRadius: 9, background: iconBg, display: "flex", alignItems: "center", justifyContent: "center", color: accent }}>
        <Icon name={icon} size={18} />
      </span>
    </div>
    <div style={{ display: "flex", flexDirection: "column", gap: 4 }}>
      <span style={{ fontSize: 30, fontWeight: 700, lineHeight: 1, color: accent, letterSpacing: "-0.02em" }}>{value}</span>
      {sub && <span style={{ fontSize: 13, color: "var(--color-text-subtle)", display: "inline-flex", alignItems: "center", gap: 5 }}>
        {trend && <Icon name={trend === "up" ? "trending-up" : "trending-down"} size={14} color={trend === "up" ? "var(--badge-success-fg)" : "var(--color-danger-primary)"} />}
        {sub}</span>}
    </div>
  </Card>;


/* ── Modal ─────────────────────────────────────────────────────────────── */
const Modal = ({ open, onClose, children, width = 460 }) => {
  if (!open) return null;
  return (
    <div onClick={onClose} style={{ position: "fixed", inset: 0, zIndex: 60, background: "rgba(17,24,39,0.5)",
      display: "flex", alignItems: "center", justifyContent: "center", padding: 24, animation: "ex-fade 160ms ease" }}>
      <div onClick={(e) => e.stopPropagation()} style={{ background: "var(--color-bg)", borderRadius: "var(--radius-lg)",
        width: "100%", maxWidth: width, boxShadow: "var(--shadow-lg)", animation: "ex-scale-in 180ms ease", overflow: "hidden" }}>
        {children}
      </div>
    </div>);

};

/* ── Toast ─────────────────────────────────────────────────────────────── */
const Toast = ({ toast }) => {
  if (!toast) return null;
  const map = {
    success: ["var(--color-toast-success-bg)", "var(--color-toast-success)", "check-circle"],
    info: ["var(--color-toast-info-bg)", "var(--color-toast-info)", "info"],
    warning: ["var(--color-toast-warning-bg)", "var(--color-toast-warning)", "alert-triangle"],
    error: ["var(--color-toast-error-bg)", "var(--color-toast-error)", "x-circle"]
  };
  const [bg, ac, ic] = map[toast.type || "success"];
  return (
    <div style={{ position: "fixed", bottom: 28, left: "50%", transform: "translateX(-50%)", zIndex: 80,
      display: "flex", alignItems: "center", gap: 12, padding: "13px 18px", borderRadius: "var(--radius-md)",
      background: bg, boxShadow: "var(--shadow-lg)", border: `1px solid ${ac}`, animation: "ex-fade-up 220ms ease", maxWidth: 440 }}>
      <Icon name={ic} size={20} color={ac} />
      <span style={{ fontSize: 14, fontWeight: 600, color: "var(--color-text)" }}>{toast.msg}</span>
    </div>);

};

/* ── Bars chart (simple) ───────────────────────────────────────────────── */
const BarChart = ({ data, height = 180, format = brl }) => {
  const max = Math.max(...data.map((d) => d.value));
  return (
    <div style={{ display: "flex", alignItems: "flex-end", gap: 16, height, paddingTop: 8 }}>
      {data.map((d, i) => {
        const h = d.value / max * (height - 36);
        return (
          <div key={i} style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", gap: 8, height: "100%", justifyContent: "flex-end" }}>
            <span style={{ fontSize: 11.5, fontWeight: 600, color: "var(--color-text-muted)" }}>{(d.value / 1000).toFixed(0)}k</span>
            <div title={format(d.value)} style={{ width: "100%", maxWidth: 46, height: h, borderRadius: "8px 8px 4px 4px",
              background: d.highlight ? "var(--color-primary)" : "var(--color-primary-soft)", transition: "height 300ms ease" }} />
            <span style={{ fontSize: 12, color: "var(--color-text-subtle)", fontWeight: d.highlight ? 700 : 500 }}>{d.label}</span>
          </div>);

      })}
    </div>);

};

/* ── FileDrop (upload de arquivo, com estado preenchido) ───────────────── */
const FileDrop = ({ filename, onAttach, onRemove, hint, accept = "PDF, DOCX · até 10 MB", icon = "file-up" }) => {
  if (filename) {
    return (
      <div style={{ display: "flex", alignItems: "center", gap: 13, padding: "13px 16px", borderRadius: "var(--radius-md)",
        border: "1px solid var(--color-primary-soft)", background: "var(--color-primary-softer)" }}>
        <span style={{ width: 40, height: 40, borderRadius: 9, background: "var(--color-bg)", border: "1px solid var(--color-border)",
          display: "flex", alignItems: "center", justifyContent: "center", color: "var(--color-danger-primary)", flexShrink: 0 }}>
          <Icon name="file-text" size={19} /></span>
        <div style={{ flex: 1, minWidth: 0 }}>
          <div style={{ fontSize: 14, fontWeight: 600, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{filename}</div>
          <div style={{ fontSize: 12.5, color: "var(--color-success)", display: "inline-flex", alignItems: "center", gap: 5 }}>
            <Icon name="check-circle-2" size={13} />Anexado</div>
        </div>
        {onRemove && <button onClick={onRemove} style={{ width: 32, height: 32, borderRadius: 8, border: "none", background: "transparent",
          cursor: "pointer", color: "var(--color-text-subtle)", display: "flex", alignItems: "center", justifyContent: "center", flexShrink: 0 }}>
          <Icon name="x" size={17} /></button>}
      </div>);

  }
  return (
    <button type="button" onClick={onAttach}
    style={{ width: "100%", display: "flex", flexDirection: "column", alignItems: "center", gap: 8, padding: "26px 20px",
      border: "2px dashed var(--color-border-input)", borderRadius: "var(--radius-md)", background: "var(--color-surface)",
      cursor: "pointer", fontFamily: "var(--font-sans)", transition: "border-color 140ms" }}
    onMouseEnter={(e) => e.currentTarget.style.borderColor = "var(--color-primary)"}
    onMouseLeave={(e) => e.currentTarget.style.borderColor = "var(--color-border-input)"} data-comment-anchor="db8b4b5aef-button-346-5">
      <span style={{ width: 44, height: 44, borderRadius: 11, background: "var(--color-primary-soft)", display: "flex", alignItems: "center", justifyContent: "center" }}>
        <Icon name={icon} size={21} color="var(--color-primary)" /></span>
      <span style={{ fontSize: 14.5, fontWeight: 600, color: "var(--color-text)" }}>{hint || "Arraste ou selecione o arquivo"}</span>
      <span style={{ fontSize: 12.5, color: "var(--color-text-subtle)" }}>{accept}</span>
    </button>);

};

Object.assign(window, {
  Icon, brl, Button, Card, Badge, StatusBadge, STATUS, Field, Input, Toggle, Checkbox,
  Segmented, Chip, Stepper, Metric, Modal, Toast, BarChart, FileDrop
});